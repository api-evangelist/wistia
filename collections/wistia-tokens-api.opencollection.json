{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wistia Data Account Tokens API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get current token details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wistia.com/v1/tokens"
          },
          "docs": "Get current token details"
        }
      ]
    }
  ],
  "bundled": true
}